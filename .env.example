# SN21 Monitor — local development
# Copy to `.env` and adjust: `cp .env.example .env`
# Loaded automatically via python-dotenv (see config.py).

# Dashboard login (required in production; set for local testing)
DASHBOARD_PASSWORD=change-me

# Where daily_log.json and owner_ledger.json live (use a writable path locally)
SN21_DATA_DIR=./data

# First day of your ownership schedule (YYYY-MM-DD)
OWNERSHIP_START_DATE=2026-03-20

# Subtensor network for chain backfill only (historical blocks need archive)
# Daily collection uses finney in code; backfill reads this env.
SUBTENSOR_ARCHIVE_NETWORK=archive

# Taostats API — daily sync of owner coldkey TAO transfers (see taostats_sync.py)
# Key from https://dash.taostats.io — Authorization header is the raw key (no "Bearer ").
TAOSTATS_API_KEY=
# SS58 of the owner coldkey to track (same as in https://taostats.io/account/.../transactions)
TAOSTATS_OWNER_ID=
# Optional: set to 1 to also query from= and to= (uses more API quota)
# TAOSTATS_TRANSFER_MERGE_DIRECTIONS=0

# House label seed — comma-separated SS58 lists. Read once on first boot;
# after that the dashboard UI is the source of truth (data/wallet_labels.json).
# Use HOUSE_COLDKEYS for wallet (coldkey) labels and HOUSE_HOTKEYS for per-neuron
# labels. A UID is "House" if either its coldkey or hotkey is labeled.
HOUSE_COLDKEYS=
HOUSE_HOTKEYS=

# Date the first non-100% burn weights apply (informational; surfaces in the
# dashboard until the live burn rate drops below 100%).
BURN_FLIP_DATE=

# ── Daily digest (digest/ package) ──────────────────────────────────────────
# Set DIGEST_ENABLED=false to silence sends without a code change.
DIGEST_ENABLED=true
# Override default 09:30 UTC schedule. Format: HH:MM (24h, UTC).
# DIGEST_TIME_UTC=09:30

# Telegram bot for the digest channel.
# Token from @BotFather, chat_id from /getUpdates after DM-ing the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API key — Claude Haiku composes the daily narrative.
# Falls back to a deterministic Python composer if missing or on error.
ANTHROPIC_API_KEY=
# Override the model if you want (default is Haiku 4.5).
# DIGEST_LLM_MODEL=claude-haiku-4-5-20251001
# DIGEST_LLM_MAX_TOKENS=1024
# Cap the prior-digests memory block (in chars) sent to the LLM. Trims
# the oldest entries once the cap is hit so input tokens stay bounded.
# DIGEST_LLM_MEMORY_CHARS=10000

# ── Scout (candidate subnet scanner) ────────────────────────────────────────
# Shortlist of candidate netuids to scan daily (comma-separated).
SCAN_NETUIDS=2,8,13,28,43
# Stakeable SN21 alpha budget used to size the per-subnet ROI projections.
SCAN_BUDGET_SN21_ALPHA=500000

# Separate Telegram channel for the weekly Scout digest (posts Mon 10:00 UTC).
# Use a different bot + chat so the daily SN21 channel stays clean.
TELEGRAM_SCOUT_BOT_TOKEN=
TELEGRAM_SCOUT_CHAT_ID=
